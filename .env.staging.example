# ============================================
# TRAVELPLAN — STAGING ENVIRONMENT TEMPLATE
# Set these in the Railway "staging" Environment's variables (not committed).
# See README.md "Staging environment" for the full setup checklist.
# ============================================

# envalid only accepts development|test|production — there is no "staging"
# value. Staging runs with NODE_ENV=production (same runtime behavior as
# prod); the environment is distinguished by which Mongo/Redis/secrets it
# points to, not by NODE_ENV. Any staging-only conditional logic in code
# must key off a dedicated var (e.g. APP_ENV=staging), not NODE_ENV.
NODE_ENV=production
PORT=3000

# ============================================
# DATABASE — separate from production, never share
# ============================================
MONGO_URI=mongodb+srv://username:password@staging-cluster.mongodb.net/travelplan_staging?retryWrites=true&w=majority

# ============================================
# REDIS — separate from production
# ============================================
REDIS_URL=

# ============================================
# AUTHENTICATION (Clerk) — use a Clerk TEST instance, not production
# ============================================
CLERK_SECRET_KEY=sk_test_your_staging_clerk_secret_key_here
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_staging_webhook_secret_here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_staging_clerk_publishable_key_here

# ============================================
# AI & EXTERNAL APIS — real keys, staging can share prod quota if the
# provider has no separate test tier (Gemini/Mapbox/Google Places usually
# don't); use STRIPE test keys since that one does have a test mode.
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
STRIPE_SECRET_KEY=sk_test_your_staging_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_staging_stripe_webhook_secret_here

# ============================================
# CORS / FRONTEND
# ============================================
FRONTEND_URL=https://staging.yourdomain.com
CORS_ALLOWED_ORIGINS=
VITE_API_URL=https://travelplan-api-staging.up.railway.app
