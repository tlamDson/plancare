# ============================================
# DEPENDENCIES
# ============================================
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# ENVIRONMENT VARIABLES (ALL LOCATIONS)
# ============================================
.env
.env.*
.env.docker
!.env.example
**/backend/.env
**/backend/.env.*
**/frontend/**/.env
**/frontend/**/.env.*
**/packages/**/.env
**/packages/**/.env.*

# ============================================
# BUILD ARTIFACTS (ALL LOCATIONS)
# ============================================
**/dist/
**/build/
**/*.tsbuildinfo
.turbo/
.cache/

# ============================================
# PRIVATE DOCUMENTATION & CONFIG
# ============================================
# Private documentation
docs/
docs/**/*

# Private UI/UX data and prompts
.shared/
.shared/**/*
.github/prompts/
.github/prompts/**/*

# Cursor AI config
.cursor/
.cursor/**/*

# Keep CI/CD workflows (exception)
!.github/workflows/
# ============================================
# IDE & EDITORS
# ============================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# TESTING
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# DOCKER
# ============================================
docker-compose.override.yml

# ============================================
# LOGS
# ============================================
logs/
*.log
pino-*.log

# ============================================
# TEMP
# ============================================
temp/
tmp/
*.tmp
